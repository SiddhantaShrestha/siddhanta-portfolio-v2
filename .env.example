# Public site origin used for canonical URLs and metadata.
# No secrets belong in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preview builds only. Set to "noindex" when building the workers.dev Worker.
# Leave unset for production so the real site stays indexable.
NEXT_PUBLIC_SITE_ROBOTS=

# AI assistant (server only). Never prefix these with NEXT_PUBLIC_.
# Leave empty to run without the AI part: the suggested questions still work.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Optional. Defaults to @cf/google/gemma-4-26b-a4b-it
ASSISTANT_MODEL=
# Model turns per UTC day, all visitors together. Default 100, max 500.
# Enforced by the Durable Object gate, see docs/phase-6b-production.md.
ASSISTANT_DAILY_LIMIT=
# Production builds refuse AI requests until the gates in
# docs/phase-6a-assistant.md and docs/phase-6b-production.md are verified.
# The shared gate must also be bound. Do not set this earlier.
ASSISTANT_PRODUCTION_GATES_CONFIRMED=

