// EXAMPLE ONLY. The live preview config is wrangler.jsonc at the repo root
// (Phase 7). This file still documents the assistant-specific bindings.
// See docs/phase-6b-production.md and docs/phase-7-preview.md.
//
// Verified in a throwaway copy with @opennextjs/cloudflare 1.20.18 and
// wrangler 4.168.0 on local workerd: Durable Object gate, Rate Limiting
// binding, vars and secrets all reached the /api/assistant route.
{
  "name": "your-worker-name",
  // Real preview config uses ".open-next/worker.js" plus
  // tools/preview/patch-worker.mjs (do not import that worker from a separate
  // entry, or Wrangler re-bundles OpenNext and page requests hang).
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // The single Durable Object that holds the shared daily budget, the
  // per-visitor window and the in-flight lock. SQLite-backed classes are the
  // only kind available on Workers Free.
  "durable_objects": {
    "bindings": [{ "name": "ASSISTANT_GATE", "class_name": "AssistantGate" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AssistantGate"] }],

  // Cheap per-location pre-filter. Approximate by design. The Durable Object
  // is the strict limit. namespace_id is any integer unique in your account.
  "ratelimits": [
    {
      "name": "ASSISTANT_EDGE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  "vars": {
    // Model turns per UTC day, all visitors together. Default 100, max 500.
    "ASSISTANT_DAILY_LIMIT": "100",
    // Leave unset or "false" until every gate in the doc is done and tested.
    // "ASSISTANT_PRODUCTION_GATES_CONFIRMED": "true"
  },

  // Secrets are NOT set here. Use:
  //   wrangler secret put CLOUDFLARE_ACCOUNT_ID
  //   wrangler secret put CLOUDFLARE_AI_API_TOKEN
}
