{
  "name": "siddhanta-portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:assistant": "node --no-warnings --import ./tools/assistant/register.mjs --test \"tests/assistant/*.test.ts\"",
    "check:assistant-bundle": "node tools/assistant/check-bundle.mjs",
    "eval:assistant-live": "node --no-warnings --env-file-if-exists=.env.local --import ./tools/assistant/register.mjs tools/assistant/live-eval.ts",
    "assets:build": "node tools/assets/build.mjs",
    "assets:optimize": "node tools/assets/optimize.mjs",
    "assets:textures": "node tools/assets/textures.mjs",
    "assets": "npm run assets:build && npm run assets:optimize && npm run assets:textures",
    "preview:build": "node tools/preview/build.mjs",
    "preview:local": "node tools/preview/build.mjs && wrangler dev --local --port 8787",
    "preview:deploy": "node tools/preview/build.mjs && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
