{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker. Separate from siddhanta-portfolio-preview.
  // Custom domain is attached only at cutover approval, not in Gate 1.
  "name": "siddhanta-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "siddhanta-portfolio",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ASSISTANT_GATE",
        "class_name": "AssistantGate",
      },
    ],
  },
  // Fresh SQLite namespace for this Worker (not shared with preview).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AssistantGate"],
    },
  ],
  "ratelimits": [
    {
      "name": "ASSISTANT_EDGE_LIMIT",
      // Distinct from preview namespace_id 1001.
      "namespace_id": "2001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "vars": {
    "ASSISTANT_DAILY_LIMIT": "100",
    // Keep workers.dev testing unindexed. Remove this var and redeploy with
    // PRODUCTION_ALLOW_INDEXING=true at domain cutover.
    "NEXT_PUBLIC_SITE_ROBOTS": "noindex",
    // Do not set ASSISTANT_PRODUCTION_GATES_CONFIRMED here.
  },
}
